# Test runtime for the Mapflow QGIS plugin.
#
# One file, two images: the Makefile builds it on a QGIS 3 LTR image and on a QGIS 4 (Qt 6) image,
# because the plugin supports both (`make docker-build`, `make docker-build-qgis4`).
#
# The repo is bind-mounted at /app at run time (see Makefile); sources are not copied in, so an
# iteration cycle is just `docker run`, not a rebuild.
ARG QGIS_IMAGE=qgis/qgis:release-3_28
FROM ${QGIS_IMAGE}

# Some images ship without pip.
RUN python3 -m pip --version > /dev/null 2>&1 \
    || (apt-get update \
        && apt-get install -y --no-install-recommends python3-pip \
        && rm -rf /var/lib/apt/lists/*)

# pytest for the tests, and the three checks plugins.qgis.org runs on plugin submission.
# Pinned deliberately: an unpinned linter silently changes its verdict when upstream adds a rule.
# detect-secrets in particular must match the version that generated .secrets.baseline.
# Newer images mark the system Python as externally managed (PEP 668) and need
# --break-system-packages; the older pip in release-3_28 doesn't know that flag.
RUN PACKAGES="pytest flake8==7.3.0 bandit==1.9.4 detect-secrets==1.5.0" \
    && (python3 -m pip install --no-cache-dir --break-system-packages $PACKAGES \
        || python3 -m pip install --no-cache-dir $PACKAGES)

# The tests drive Qt without a display.
ENV QT_QPA_PLATFORM=offscreen \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
